NODE_ENV=production
PORT=3000

APP_NAME=nuxt-app
APP_PORT=3000
HEALTH_PATH=/

APP_URL=https://example.com
PUBLIC_URL=

LOG_DIR=/var/log/nuxt-app
RELEASE_DIR=/opt/nuxt-app

EXPECTED_STATUS=200
TIMEOUT_SECONDS=10
HEALTH_RETRIES=5
HEALTH_RETRY_DELAY=2

# Secrets belong in /etc/nuxt-app/nuxt-app.env on the host.
DATABASE_URL=
API_TOKEN=
SESSION_SECRET=